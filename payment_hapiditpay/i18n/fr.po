msgstr "Adresse du webhook HapiditPay"

#. module: payment_hapiditpay
#: model:ir.model.fields,field_description:payment_hapiditpay.field_payment_provider__hapiditpay_webhook_secret
msgid "HapiditPay webhook secret"
msgstr "Secret du webhook HapiditPay"

#. module: payment_hapiditpay
#: model:ir.model.fields,help:payment_hapiditpay.field_payment_provider__hapiditpay_webhook_secret
msgid ""
"In your HapiditPay space, Developers > Webhooks, add the webhook address shown "
"here, then copy its secret."
msgstr ""
"Dans votre espace HapiditPay, menu Développeurs > Webhooks, ajoutez l'adresse "
"du webhook indiquée ici, puis copiez son secret."

#. module: payment_hapiditpay
#. odoo-python
#: code:addons/payment_hapiditpay/models/payment_provider.py:0
msgid "Key recognised for \"%(name)s\", in %(mode)s mode."
msgstr "Clé reconnue pour « %(name)s », en mode %(mode)s."

#. module: payment_hapiditpay
#: model:ir.model.fields,help:payment_hapiditpay.field_payment_provider__hapiditpay_api_url
msgid ""
"Leave empty to use https://hapiditpay.com/api/v1. The address must be "
"HTTPS: a redirected address is refused."
msgstr ""
"Laissez vide pour utiliser https://hapiditpay.com/api/v1. L'adresse doit "
"être en HTTPS : une adresse redirigée est refusée."

#. module: payment_hapiditpay
#. odoo-python
#: code:addons/payment_hapiditpay/models/payment_transaction.py:0
msgid "No transaction found matching reference %s."
msgstr "Aucune transaction ne correspond à la référence %s."

