#. module: payment_hapiditpay
#. odoo-python
#: code:addons/payment_hapiditpay/models/payment_transaction.py:0
msgid ""
"HapiditPay confirmed a payment of %s, which does not match this transaction. "
"Check it in your HapiditPay space."
msgstr ""
"HapiditPay a confirmé un paiement de %s, qui ne correspond pas à cette "
"transaction. Vérifiez-le dans votre espace HapiditPay."

#. module: payment_hapiditpay
#: model_terms:ir.ui.view,arch_db:payment_hapiditpay.payment_provider_form
msgid "HapiditPay space"
msgstr "espace HapiditPay"

#. module: payment_hapiditpay
#: model:ir.model.fields,field_description:payment_hapiditpay.field_payment_provider__hapiditpay_webhook_url
