#: model:ir.model,name:payment_hapiditpay.model_payment_provider
msgid "Payment Provider"
msgstr "Fournisseur de paiement"

#. module: payment_hapiditpay
#: model:ir.model,name:payment_hapiditpay.model_payment_transaction
msgid "Payment Transaction"
msgstr "Transaction"

#. module: payment_hapiditpay
#. odoo-python
#: code:addons/payment_hapiditpay/models/payment_transaction.py:0
msgid "Received data with missing reference."
msgstr "Données reçues sans référence."

#. module: payment_hapiditpay
#. odoo-python
#: code:addons/payment_hapiditpay/models/payment_provider.py:0
msgid "The API answered %s."
msgstr "L'API a répondu %s."

#. module: payment_hapiditpay
#. odoo-python
#: code:addons/payment_hapiditpay/models/payment_provider.py:0
msgid ""
"The API answered with a redirection (%(status)s): check the API address, in "
"HTTPS, for example %(url)s."
msgstr ""
"L'API a répondu par une redirection (%(status)s) : vérifiez l'adresse de "
"l'API, en HTTPS, par exemple %(url)s."

#. module: payment_hapiditpay
#. odoo-python
#: code:addons/payment_hapiditpay/models/payment_provider.py:0
msgid "The key could not be checked: %s"
msgstr "La clé n'a pas pu être vérifiée : %s"

#. module: payment_hapiditpay
#: model_terms:ir.ui.view,arch_db:payment_hapiditpay.payment_provider_form
msgid ""
"The money paid by your customers goes straight to your own operator account:\n"
"                        HapiditPay never touches it and takes no commission.\n"
"                        No HapiditPay account yet?"
msgstr ""
"L'argent payé par vos clients arrive directement sur votre propre compte "
"opérateur : HapiditPay ne le touche jamais, et ne prend aucune commission. Pas "
"encore de compte HapiditPay ?"

#. module: payment_hapiditpay
#. odoo-python
#: code:addons/payment_hapiditpay/models/payment_transaction.py:0
msgid ""
"The operator did not answer clearly: HapiditPay is checking this payment. Do "
"not deliver until it is confirmed."
msgstr ""
"L'opérateur n'a pas répondu clairement : HapiditPay vérifie ce paiement. Ne "
"livrez pas avant sa confirmation."

#. module: payment_hapiditpay
#. odoo-python
#: code:addons/payment_hapiditpay/models/payment_transaction.py:0
msgid "The payment page could not be created."
msgstr "La page de paiement n'a pas pu être créée."

#. module: payment_hapiditpay
#: model:ir.model.fields,help:payment_hapiditpay.field_payment_provider__code
msgid "The technical code of this payment provider."
msgstr "Le code technique de ce fournisseur de paiement."

#. module: payment_hapiditpay
#. odoo-python
#: code:addons/payment_hapiditpay/models/payment_transaction.py:0
msgid "This amount has cents: HapiditPay only accepts whole amounts."
msgstr ""
"Ce montant comporte des centimes : HapiditPay n'accepte que des montants "
"entiers."

