#. module: payment_hapipay
#: model:ir.model.fields,field_description:payment_hapipay.field_payment_provider__hapipay_api_key
msgid "HapiPay API key"
msgstr "Clé d'API HapiPay"

#. module: payment_hapipay
#. odoo-python
#: code:addons/payment_hapipay/models/payment_transaction.py:0
msgid ""
"HapiPay confirmed a payment of %s, which does not match this transaction. "
"Check it in your HapiPay space."
msgstr ""
"HapiPay a confirmé un paiement de %s, qui ne correspond pas à cette "
"transaction. Vérifiez-le dans votre espace HapiPay."

#. module: payment_hapipay
#: model_terms:ir.ui.view,arch_db:payment_hapipay.payment_provider_form
msgid "HapiPay space"
msgstr "espace HapiPay"

#. module: payment_hapipay
#: model:ir.model.fields,field_description:payment_hapipay.field_payment_provider__hapipay_webhook_url
msgid "HapiPay webhook address"
msgstr "Adresse du webhook HapiPay"

#. module: payment_hapipay
#: model:ir.model.fields,field_description:payment_hapipay.field_payment_provider__hapipay_webhook_secret
msgid "HapiPay webhook secret"
msgstr "Secret du webhook HapiPay"

#. module: payment_hapipay
#: model:ir.model.fields,help:payment_hapipay.field_payment_provider__hapipay_webhook_secret
msgid ""
"In your HapiPay space, Developers > Webhooks, add the webhook address shown "
"here, then copy its secret."
msgstr ""
"Dans votre espace HapiPay, menu Développeurs > Webhooks, ajoutez l'adresse "
"du webhook indiquée ici, puis copiez son secret."

#. module: payment_hapipay
#. odoo-python
#: code:addons/payment_hapipay/models/payment_provider.py:0
msgid "Key recognised for \"%(name)s\", in %(mode)s mode."
msgstr "Clé reconnue pour « %(name)s », en mode %(mode)s."

#. module: payment_hapipay
#: model:ir.model.fields,help:payment_hapipay.field_payment_provider__hapipay_api_url
msgid ""
"Leave empty to use https://pay.scigroup.td/api/v1. The address must be "
"HTTPS: a redirected address is refused."
msgstr ""
"Laissez vide pour utiliser https://pay.scigroup.td/api/v1. L'adresse doit "
"être en HTTPS : une adresse redirigée est refusée."

#. module: payment_hapipay
#. odoo-python
#: code:addons/payment_hapipay/models/payment_transaction.py:0
msgid "No transaction found matching reference %s."
msgstr "Aucune transaction ne correspond à la référence %s."

