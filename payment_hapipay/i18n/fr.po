msgid "Payment Provider"
msgstr "Fournisseur de paiement"

#. module: payment_hapipay
#: model:ir.model,name:payment_hapipay.model_payment_transaction
msgid "Payment Transaction"
msgstr "Transaction"

#. module: payment_hapipay
#. odoo-python
#: code:addons/payment_hapipay/models/payment_transaction.py:0
