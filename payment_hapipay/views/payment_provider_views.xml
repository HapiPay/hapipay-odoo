<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">HapiPay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'hapipay'" name="hapipay_credentials">
                    <div class="alert alert-info" role="status" colspan="2">
                        The money paid by your customers goes straight to your own operator account:
                        HapiPay never touches it and takes no commission.
                        No HapiPay account yet? <a href="https://pay.scigroup.td/portail/register" target="_blank">Create one</a>:
                        the test environment is free. API keys and webhooks are in the Developers menu of your
                        <a href="https://pay.scigroup.td/portail" target="_blank">HapiPay space</a>.
                    </div>
                    <field name="hapipay_api_url" string="API address"
                           placeholder="https://pay.scigroup.td/api/v1"/>
                    <field name="hapipay_api_key" string="API key"
                           required="code == 'hapipay' and state != 'disabled'" password="True"/>
                    <field name="hapipay_webhook_url" string="Webhook address" readonly="1" widget="CopyClipboardChar"/>
                    <field name="hapipay_webhook_secret" string="Webhook secret"
                           required="code == 'hapipay' and state != 'disabled'" password="True"/>
                    <button name="action_hapipay_check_key" type="object" string="Check the key"
                            class="btn-secondary" colspan="2"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
